[23:17, 19/08/2026] Shambhaviiii Mote: -- Optimized CTE replacing nested correlated subquery
WITH RestaurantAvgPrice AS (
    SELECT 
        RestaurantID, 
        AVG(Price) AS AvgPrice
    FROM MenuItem
    GROUP BY RestaurantID
)
SELECT 
    m.ItemID, 
    m.ItemName, 
    m.Price, 
    m.RestaurantID
FROM MenuItem m
INNER JOIN RestaurantAvgPrice rap ON m.RestaurantID = rap.RestaurantID
WHERE m.Price > rap.AvgPrice;
